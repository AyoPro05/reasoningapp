{
  "name": "reasoningapp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": { "node": "24.22.2", "pnpm": "10.34.9" },
  "scripts": {
    "dev:api": "tsx --env-file-if-exists=.env apps/api/src/server.ts",
    "dev:worker": "tsx --env-file-if-exists=.env apps/worker/src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "db:migrate": "pnpm --filter @reasoningapp/database db:migrate",
    "db:seed": "pnpm --filter @reasoningapp/database db:seed"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "tsx": "4.23.15",
    "vitest": "5.1.0"
  }
}
