# Copy to .env for local use. Never commit the populated file.
# readConfig requires an explicit environment; APP_ENV must match NODE_ENV.
NODE_ENV=development
APP_ENV=development
DATABASE_URL=postgresql://reasoningapp:local-dev-only@127.0.0.1:5432/reasoningapp_dev
REDIS_URL=redis://127.0.0.1:6379/0
AUTH_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000
MOBILE_ORIGIN=reasoningapp://
TRUSTED_ORIGINS=http://localhost:3000,reasoningapp://
# Generate: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# This placeholder is deliberately rejected by readConfig.
AUTH_SECRET=replace-with-at-least-32-random-characters
DEVELOPMENT_FIXTURES_ENABLED=false
SKIP_EMAIL_VERIFICATION=false
SEED_VERIFIED_USERS=false
ALLOW_UNREVIEWED_CONTENT=false
AI_ASSISTANCE_ENABLED=false
LIVE_BILLING_ENABLED=false
# fake is mandatory in test/production. mailpit is development-only.
MAIL_PROVIDER=fake
# Optional only for local Mailpit: MAIL_PROVIDER=mailpit
# SMTP_URL=smtp://127.0.0.1:1025
